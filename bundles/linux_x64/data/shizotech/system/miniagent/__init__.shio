
import webserver;
import leveldb;

#include "miniagent"

#include "cfg"

//#include "web_api"

//Initialize agent
planner = miniagent(cfg.api, None, "planner/orchestrator", cfg.token); //So that the local agent.space aswell as the global agent.space are visible

last_state = "";

planner.on_action = [&last_state](action) {
	if(action.text) {
		if(*last_state != "text")
			*last_state = "text";
			std.cout("\n");
		
		stdfcol("white");
		std.cout(action.text);
	}
	
	if(action.reasoning) {
		if(*last_state != "reasoning")
			*last_state = "reasoning";
			std.cout("\n");
		
		stdfcol("yellow");
		std.cout(action.reasoning);
	}
	
	if(action.tool) {
		if(*last_state != "tool")
			*last_state = "tool";
			std.cout("\n\n");
			
		stdfcol("yellow");
		std.cout("[TOOL] ");
		stdfcol("magenta");
		std.cout(action.tool.name + "()", action.tool.args.has("path") ? "> " + action.tool.args.path : "", "\n");
		stdfcol("white");
	}
};

if(!skip_first_command)
{
	if(std.argc() == 2) {
		//Run single prompt
		planner.task(std.argv(1));
		return;
	}
	else(std.argc() != 1) {
		std.error("Invalid command!");
		return;
	}
}



check_command(planner, cmd) {
	if(cmd == "/clear")
		planner.llm_api.context.clear();
		std.print("Cleared history.");
	else
		std.print("unknown command.");
}

for(1) {
	std.color("green");
	cmd = std.input(">>> (user) ").strip();

	//One fixed command, /load for loading prompt text files
	if(cmd.starts("/load")) {
		cmd = cmd.removeprefix("/load").strip();
	}
	else if(cmd.starts("/"))
		check_command(planner, cmd);
		continue;
	
	if(cmd.empty())
		continue;
	
	std.cout("\n");
	
	stdfcol("magenta");
	std.cout("(miniagent) ");
	
	try {
		result = planner.task(cmd);
		if(result.ok && result.reports)
			std.cout(result.reports[0].report);
		fileio.remove(".plan");
		std.cout("\nTOKEN USAGE:\n\n");
		token_usage_global = std.global("_global_token_usage");
		std.cout(token_usage_global["usage"] + "\n\n");
	}
	catch(e) {
		
	}
	
	std.cout("\n");
	std.cout("\n");
}