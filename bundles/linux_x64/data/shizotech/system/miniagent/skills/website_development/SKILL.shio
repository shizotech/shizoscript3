
import webserver;

web_probe_src = R"(
from selenium import webdriver
from selenium.webdriver.chrome.options import Options
import sys
import time
import json

url = sys.argv[1]

options = Options()
options.add_argument("--headless=new")

driver = webdriver.Chrome(options=options)

errors = []

try:
    driver.get(url)
    time.sleep(2)

    logs = driver.get_log("browser")

    for entry in logs:
        if entry["level"] == "SEVERE":
            errors.append(entry["message"])

    result = {
        "ok": len(errors) == 0,
        "errors": errors
    }

    print(json.dumps(result))

    # IMPORTANT: set exit code
    if len(errors) > 0:
        sys.exit(1)
    else:
        sys.exit(0)

finally:
    driver.quit()
)";

add_tools(agt)
{
	agt.add_tool(
		"tsc_compile",
		"Build the website and returns a report",
		[
			path = "&string(): Path to the ts project",
			//context = "&string(): Context for this action",
		],
		[](agt, args)
		{		
			if(std.system("npx tsc --project \"" + args.path + "\"")) {
				//Fail, try again and capture output...
				capture = std.system("npx tsc --project \"" + args.path + "\"", true);
				return capture;
			}
			
			//Next stage, check if website loads
			managed server = webserver.http_server(13337);
			server.static("", ".");
			server.start();
			
			std.sleep(500);
			
			web_probe_path = args.path + "/web_probe.py";
			fileio.write_string(web_probe_path, web_probe_src);
			
			//Turn into node "<path>+/web_probe.js"...
			if(std.system("python \"" + web_probe_path + "\" http://localhost:13337")) {
				//Fail, try again and capture output...
				capture = std.system("python \"" + web_probe_path + "\" http://localhost:13337", true);
				fileio.remove(web_probe_path);
				return [
					ok = false,
					capture = capture,
					status = "tsc itself was successful, however the runtime check on the live website failed with the errors captured in 'capture'.", 
				];
			}
			fileio.remove(web_probe_path);
			return [
				ok = true,
				status = "No errors reported.",
			];
		}
	);
	
	agt.add_tool(
		"bundle_build",
		"Bundles a web project into browser-executable JS, resolving all module imports",
		[
			path = "&string(): Path to project root",
			entry = "&string(): Entry file (e.g. src/main.ts)"
		],
		[](agt, args)
		{
			// Example implementation (system-level tool)
			result = std.system(
				"npx esbuild \"" + args.entry + "\" --bundle --outfile=\"" + args.path + "/dist/app.js\"",
				true
			);

			return result;
		}
	);
	
	agt.add_tool(
		"node_install",
		"ATOMIC Installs Node.js dependencies into node_modules for the current project",
		[
			path = "&string(): Path to project root",
			packages = "&string(): Space-separated list of npm packages (e.g. 'three lodash')"
		],
		[](agt, args)
		{
			managed lock = std.critical_section("node_install");
			
			wd = std.wd();
			std.cd(args.path);
			
			std.system("npm init -y");
			
			cmd = "npm install " + args.packages;
			result = std.system(cmd, true);

			std.cd(wd);

			return result;
		}
	);
	
	/*
	agt.add_tool(
		"web_debug",
		"Run the website in a browser and catch runtime errors",
		[
			path = "&string(): Path to the ts project",
			//context = "&string(): Context for this action",
		],
		[](agt, args)
		{		
			
			
			//Next stage, check if website loads
			
			return [
				ok = true,
			];
		}
	);
	*/
}