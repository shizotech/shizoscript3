
import tempfile;

add_tools(agt)
{
	agt.add_tool(
		"shizoscript_docs",
		"Resolve docs for a namespaces, function, classes, objects or variable path.",
		[
			path = "&string(): A namespace like 'std' or a dotted path like 'math.sin' or 'math.sin()' or an object type like 'nanogui.widget'"
		],
		[](agt, args)
		{		
			res = shzdocs.get_namespace(args.path);
			
			if(res.found) {
				std.print(res);
				if(res.has("documentation"))
					res.erase("documentation");
				return res;
			}
			
			res = shzdocs.get_class(args.path);
			
			if(res.found) {
				//std.print(res);
				if(res.has("documentation"))
					res.erase("documentation");
				return res;
			}
			
			res = shzdocs.get_path(args.path);
			
			if(res.found) {
				//std.print(res);
				if(res.has("documentation"))
					res.erase("documentation");
				return res;
			}
		
			return [
				found = false,
				status = "The requested path does not exist.",
			];
		}
	);
	
	agt.add_tool(
		"shizoscript_resolve_include",
		"Resolve standard include files",
		[
			path = "&string(): Path of the included file"
		],
		[](agt, args)
		{		
			return std.resolve_source_file(args.path);
		}
	);
	
	agt.add_tool(
		"shizoscript_debug_file",
		"Resolve standard include files",
		[
			path = "&string(): Path of the script file to check",
			run_duration = "&int(0,60): Duration that the script should run for this test (set to 0 to disable this and check syntax only)",
		],
		[](agt, args)
		{
			captured_out = "";
			
			managed tmp = tempfile.tempfile();
			
			if(args.run_duration == 0)		
				std.system("shz --check " + args.path + " > " + tmp.path());
			else
				std.system("shz --testrun " + args.run_duration + " " + args.path + " > " + tmp.path());
		
			return tmp.read();
		}
	);
}
	