        return [body = format_api_response(false, None, "Invalid request body")];
    }
    
    try {
        // Generate new expert group ID
        expertgroup_id = "expertgroup_" + std.date("%d-%m-%Y_%H-%M-%S") + "_" + std.random_hash();
        
        // Create new expert group with defaults
        expertgroup = [
            id = expertgroup_id,
            createdAt = std.millis(),
            updatedAt = std.millis(),
            agentIds = [],
            messages = [],
            personalities = [],
        ];
        
        // Copy provided fields
        if(body.name)
            expertgroup.name = body.name;
        if(body.description)
            expertgroup.description = body.description;
        if(body.agentIds)
            expertgroup.agentIds = body.agentIds;
		if(body.agents)
			expertgroup.agents = body.agents;
        if(body.personalities)
            expertgroup.personalities = body.personalities;
        
        // Save to database
        expertgroups_db.put(expertgroup_id, expertgroup);
        
        return [body = format_api_response(true, expertgroup)];
