agent_active_lock = [];

//Kind of hackery, used to manually add tools
//Make an official better way for that later...
#include "roles/SHARED"

process_group_agent(&expertgroup, agentId) {
	
	//Todo: this function somewhat should run in a loop until
	//All agents decided to stop talking and there are no new messages
	//Currently they only "loop" once but thats ok for now
	
	agent_uid = expertgroup.id + "_" + agentId;
	
	if(agent_active_lock.has(agent_uid)) {
		//Agent thread already active
		return;
	}
	
	//std.print(expertgroup);

	agent_active_lock[agent_uid] = [
		active = true,
	];
	
	//Basically run forever until error, these threads get "kicked off once"
	//And then run forever to simulate a proper message loop.
	//Maybe there is a better architecture but this technically should work

	agt = miniagent(cfg.api, None, "chatparticient", cfg.token); 
	agent_active_lock[agent_uid].agent = agt;
	
	agent_config = None;
		
	if(expertgroup.agents ?? false) {
		for(i = 0; i < expertgroup.agents.size(); i++) {
			if(expertgroup.agents[i].id == agentId) {
				agent_config = expertgroup.agents[i];
			}
		}
	}
	
	//Kind of stupid lol
	if(agent_config.canReadFiles == "false") agent_config.canReadFiles = false;
	if(agent_config.canWriteFiles == "false") agent_config.canWriteFiles = false;
	if(agent_config.canUseSkills == "false") agent_config.canUseSkills = false;
	
	if(agent_config.canReadFiles) {
		add_read_tools(agt);
		add_code_read_tools(agt);
	}
	if(agent_config.canWriteFiles) {
		add_write_tools(agt);
	}
	if(agent_config.canUseSkills) {
		add_skill_tools(agt);
	}

	last_read_msg_index = 0;

	for(1) {
		try {
			prompt = "<participants>\n";
			prompt += "<participant name=\"user\" type=\"human\"/>\n";
			for(i = 0; i < expertgroup.agentIds.size(); i++) {
				id = expertgroup.agentIds[i];
				prompt += "<participant name=\"" + id + "\" type=\"agent\">\n" + expertgroup.personalities[id] + "\n</participant>\n";
			}
			
			prompt += "</participants>\n\n";
			
			prompt += "<new_messages>\n\n";
			
			//Fix in shizoscript for(;..;) doesnt work if statement is empty...
			
			last_task = "";
			
			for(last_read_msg_index < expertgroup.messages.size()) {
				msg = &expertgroup.messages[last_read_msg_index];
				type = msg.agentId == "user" ? "human" : "agent";
				
				if(msg.agentId == "user")
					last_task = msg.content;
				
				messageTag =
					"<message id=\"" + msg.id +
					"\" author=\"" + msg.agentId +
					"\" type=\"" + type + "\"";
					
				if (agentId == msg.agentId) {
					messageTag += " active_agent=\"true\"";
				}
				
				messageTag += ">\n";

				prompt += messageTag;
				prompt += msg.content;
				prompt += "\n</message>\n\n";
				
				last_read_msg_index++;
			}
			
			prompt += "</new_messages>\n\n";
			prompt += "<current_objective>\n" + last_task + "\n</current_objective>\n\n";
			prompt += "<self>\n" + agentId + "\n</self>\n\n";
			
			if(expertgroup.personalities[agentId])
				prompt += "<personality>\n" + expertgroup.personalities[agentId] + "\n</personality>";
			
			agt.env.expertgroup_id = expertgroup.id;
			agt.env.last_read_message_id = expertgroup.messages[-1].id;
			agt.env.expertgroups_db = expertgroups_db;
			agt.env.agentId = agentId;
			
			//Checkout roles/chatparticient for how sending messages is handled.
			agt.single_task(prompt);
			
			if(!agt.env.finished_turn_check) //Agent didnt call send_message and also didnt call finish()
			{
				agt.single_task("Complete your turn by either calling 'send_message' to send a message to the group chat or 'finish' to end your turn.");
			}
			
			//Re-read and sleep until a new message arrived...
			last_read_message_id = agt.env.last_read_message_id;
			
			for(1) {
				expertgroup = expertgroups_db.get(expertgroup.id);
				if(expertgroup.messages[-1].id == last_read_message_id)
					std.sleep(1000 * 15);
				else
					break;
			}
		}
		catch(e) {
			//Safer to kill the agent for now, do proper error handling later
			break;
		}
	}
	
	agent_active_lock.erase(agent_uid);
}

process_group(&expertgroup) {
	// Process user message
	agent_threads = std.thread(process_group_agent);
	
	for(i = 0; i < expertgroup.agentIds.size(); i++) {
		agent_threads.run(&expertgroup, expertgroup.agentIds[i]);
	}
	
	//Detail: dont join() on the threads.
}

// POST /api/expertgroups/:id/messages - Add message to expert group
server.route("POST", "^/api/expertgroups/([a-zA-Z0-9_-]+)/messages$", [this](req, res) {
    
    if(!expertgroups_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    expertgroup_id = req.matches[0];
    body = parse_expertgroup_request_body(req.body);
    
    if(!body) {
        return [body = format_api_response(false, None, "Invalid request body")];
    }
    
    try {
        if(!expertgroups_db.exists(expertgroup_id)) {
            return [body = format_api_response(false, None, "Expert group not found")];
        }
        
        expertgroup = expertgroups_db.get(expertgroup_id);
        
        // Initialize messages if it doesn't exist
        if(!expertgroup.messages)
            expertgroup.messages = [];
        
        // Initialize personalities if it doesn't exist
        if(!expertgroup.personalities)
            expertgroup.personalities = [];
        
        // Generate new message ID
        message_id = "msg_" + std.date("%d-%m-%Y_%H-%M-%S") + "_" + std.random_hash();
        
        // Create new message
        message = [
            id = message_id,
            timestamp = std.millis(),
        ];
        
        // Copy provided fields
        if(body.agentId)
            message.agentId = body.agentId;
        if(body.content)
            message.content = body.content;
        
        // Add message to group
        expertgroup.messages.push_back(message);
        
        // Update personalities from request if provided
        if(body.personalities) {
            // Merge personalities (update existing, add new)
            if(body.agents ?? false) {
				expertgroup.agents = body.agents;
			}
			for(i = 0; i < body.personalities.size(); i++) {
				key = body.personalities.key(i);
                expertgroup.personalities[key] = body.personalities[key];
				
				for(j = 0; j < expertgroup.agents.size(); j++) {
					if(expertgroup.agents[j].id == key) {
						expertgroup.agents[j].personality = body.personalities[key];
						break;
					}
				}
			}
        }
        
        // Update timestamp
        expertgroup.updatedAt = std.millis();
        
        // Save updated expert group
        expertgroups_db.put(expertgroup_id, expertgroup);
        
		if(message.agentId == "user")
			process_group(&expertgroup);
		
        return [body = format_api_response(true, message)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

server.start();
			
std.print("Webinterface: " + "http://localhost:13337\n");

std.system("start http://localhost:13337");