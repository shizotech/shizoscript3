// ════════════════════════════════════════════
//  Dashboard API Backend
// ════════════════════════════════════════════
// This module provides RESTful API endpoints for:
// - Features Module (feature tracker)
// - Bugs Module (bug tracker)
// - History Module (action history)
// - Settings Module (dashboard settings)
// - Work Mode Module (agent activity control)
//
// All endpoints follow a common response format:
// {
//   "ok": true/false,
//   "data": {...},  // Optional: response data
//   "error": "..."  // Optional: error message
// }
//
// Polling Strategy:
// - Initial load: Frontend fetches all entries once
// - Regular updates: Frontend polls every 2 seconds for updates
// - Backend manages all data (AI agents add/remove/update entries)
// - No human controls except initial creation/direct examination

// Initialize LevelDB for dashboard data persistence
features_db = leveldb.db(agent_space + "dashboard/features.db");
bugs_db = leveldb.db(agent_space + "dashboard/bugs.db");
history_db = leveldb.db(agent_space + "dashboard/history.db");
settings_db = leveldb.db(agent_space + "dashboard/settings.db");

// Helper function to format API response
format_api_response(ok, data = None, error = "") {
    response = [ok = ok];
    
    if(ok && data)
        response.data = data;
    
    if(!ok && error)
        response.error = error;
    
    return std.string(response);
}

// Helper function to parse JSON from request body
parse_request_body(body) {
    try {
        json = std.json(body);
        // Check if JSON object is empty (size == 0)
        if(json.size && json.size() == 0)
            return None;
        return json;
    }
    catch(e) {
        return None;
    }
}

// Helper function to get default settings
get_default_settings() {
    return [
        maxActiveAgents = 5,
        checkInterval = 5000
    ];
}

// Helper function to get default work mode
get_default_workmode() {
    return [enabled = true];
}

// ════════════════════════════════════════════
//  Settings API Endpoints
// ════════════════════════════════════════════

// GET /api/settings - Get current settings
server.route("GET", "^/api/settings$", [this](req, res) {
    
    if(!settings_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    try {
        // Get existing settings or return defaults
        if(settings_db.exists("settings")) {
            settings = settings_db.get("settings");
            return [body = format_api_response(true, settings)];
        }
        
        // Return default settings
        default_settings = get_default_settings();
        return [body = format_api_response(true, default_settings)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// PUT /api/settings - Update settings
server.route("PUT", "^/api/settings$", [this](req, res) {
    
    if(!settings_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    body = parse_request_body(req.body);
    
    if(!body) {
        return [body = format_api_response(false, None, "Invalid request body")];
    }
    
    try {
        // Get existing settings or create defaults
		settings = None;
        if(settings_db.exists("settings")) {
            settings = settings_db.get("settings");
        } else {
            settings = get_default_settings();
        }
        
        // Update provided fields
        if(body.maxActiveAgents)
            settings.maxActiveAgents = body.maxActiveAgents;
        if(body.checkInterval)
            settings.checkInterval = body.checkInterval;
        
        // Save to database
        settings_db.put("settings", settings);
        
        return [body = format_api_response(true, settings)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// ════════════════════════════════════════════
//  Work Mode API Endpoints
// ════════════════════════════════════════════

// GET /api/workmode - Get current work mode
server.route("GET", "^/api/workmode$", [this](req, res) {
    
    if(!settings_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    try {
        // Get existing settings
        if(settings_db.exists("settings")) {
            settings = settings_db.get("settings");
            
            // Get workmode from settings (nested structure)
            if(settings.workmode != None) {
                workmode = settings.workmode;
                return [body = format_api_response(true, workmode)];
            }
            
            // Return default work mode if not in settings
            default_workmode = get_default_workmode();
            return [body = format_api_response(true, default_workmode)];
        }
        
        // Return default work mode if no settings exist
        default_workmode = get_default_workmode();
        return [body = format_api_response(true, default_workmode)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// PUT /api/workmode - Set work mode
server.route("PUT", "^/api/workmode$", [this](req, res) {
    
    if(!settings_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    body = parse_request_body(req.body);
    
    if(!body) {
        return [body = format_api_response(false, None, "Invalid request body")];
    }
    
    try {
        // Get existing settings or create defaults
		settings = None;
        if(settings_db.exists("settings")) {
            settings = settings_db.get("settings");
        } else {
            settings = get_default_settings();
        }
        
        // Initialize workmode if it doesn't exist in settings
        if(settings.workmode == None)
            settings.workmode = get_default_workmode();
        
        // Update enabled state
        if(body.enabled != None)
            settings.workmode.enabled = body.enabled;
        
        // Save settings to database
        settings_db.put("settings", settings);
        
        return [body = format_api_response(true, settings.workmode)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// ════════════════════════════════════════════
//  Features API Endpoints
// ════════════════════════════════════════════

// GET /api/features/list - Get all features
server.route("GET", "^/api/features/list$", [this](req, res) {
	
	if(!features_db)
		return [body = format_api_response(false, None, "Not enabled.")];
	
    features = [];
    
    try {
        iter = features_db.iter();
        
        for(iter.valid()) {
			key = iter.key();
            if(!key)
                break;
			
            value = features_db.get(key);
            feature = std.json(value);
            
            if(feature)
                features.push_back(feature);
			
			//Does not return the key, but true/false
			iter.next();
		}
		
        return [body = format_api_response(true, features)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// GET /api/features/:id - Get specific feature
server.route("GET", "^/api/features/([a-zA-Z0-9_-]+)$", [this](req, res) {
	
	if(!features_db)
		return [body = format_api_response(false, None, "Not enabled.")];
	
	feature_id = req.matches[0];
    
    try {
        if(features_db.exists(feature_id)) {
            feature = features_db.get(feature_id);
            return [body = format_api_response(true, feature)];
        }
        
        return [body = format_api_response(false, None, "Feature not found")];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// POST /api/features - Create new feature
server.route("POST", "^/api/features$", [this](req, res) {
	
	if(!features_db)
		return [body = format_api_response(false, None, "Not enabled.")];
	
    body = parse_request_body(req.body);
    
    if(!body) {
        return [body = format_api_response(false, None, "Invalid request body")];
    }
    
    try {
        // Generate new feature ID
        feature_id = "feature_" + std.date("%d-%m-%Y_%H-%M-%S") + "_" + std.random_hash();
        
        // Create new feature with defaults
        feature = [
            id = feature_id,
            createdAt = std.millis(),
            updatedAt = std.millis(),
            progress = 0,
            status = "planned",
        ];
        
        // Copy provided fields
        if(body.title)
            feature.title = body.title;
        if(body.description)
            feature.description = body.description;
        if(body.priority)
            feature.priority = body.priority;
        if(body.category)
            feature.category = body.category;
        if(body.targetDate)
            feature.targetDate = body.targetDate;
		
        // Save to database
        features_db.put(feature_id, feature);
		
        return [body = format_api_response(true, feature)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// PUT /api/features/:id - Update feature
server.route("PUT", "^/api/features/([a-zA-Z0-9_-]+)$", [this](req, res) {
	
	if(!features_db)
		return [body = format_api_response(false, None, "Not enabled.")];
	
	feature_id = req.matches[0];
    body = parse_request_body(req.body);
    
    if(!body) {
        return [body = format_api_response(false, None, "Invalid request body")];
    }
    
    try {
        if(!features_db.exists(feature_id)) {
            return [body = format_api_response(false, None, "Feature not found")];
        }
        
        feature = features_db.get(feature_id);
        
        // Update fields
        feature.updatedAt = std.millis();
        
        if(body.title)
            feature.title = body.title;
        if(body.description)
            feature.description = body.description;
        if(body.priority)
            feature.priority = body.priority;
        if(body.category)
            feature.category = body.category;
        if(body.targetDate)
            feature.targetDate = body.targetDate;
        if(body.status)
            feature.status = body.status;
        if(body.progress)
            feature.progress = body.progress;

        // Save updated feature
        features_db.put(feature_id, feature);
        
        // Log the update
        std.print(std.string("[", std.date("%d-%m-%Y_%H-%M-%S"), "] Updated feature: id=", feature_id, ", updated fields: title=", feature.title, ", description=", feature.description, ", priority=", feature.priority, ", category=", feature.category, ", targetDate=", feature.targetDate, ", status=", feature.status, ", progress=", feature.progress));
        
        return [body = format_api_response(true, feature)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// DELETE /api/features/:id - Delete feature
server.route("DELETE", "^/api/features/([a-zA-Z0-9_-]+)$", [this](req, res) {
	
	if(!features_db)
		return [body = format_api_response(false, None, "Not enabled.")];
	
	feature_id = req.matches[0];
    
    try {
        if(features_db.exists(feature_id)) {
            features_db.delete(feature_id);
            return [body = format_api_response(true)];
        }
        
        return [body = format_api_response(false, None, "Feature not found")];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

