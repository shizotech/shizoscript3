// POST /api/expertgroups/:id/agents - Add agent to expert group
server.route("POST", "^/api/expertgroups/([a-zA-Z0-9_-]+)/agents$", [this](req, res) {
    
    if(!expertgroups_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    expertgroup_id = req.matches[0];
    body = parse_expertgroup_request_body(req.body);
    
    if(!body) {
        return [body = format_api_response(false, None, "Invalid request body")];
    }
    
	std.print(body);
	
    try {
        if(!expertgroups_db.exists(expertgroup_id)) {
            return [body = format_api_response(false, None, "Expert group not found")];
        }
		
        expertgroup = expertgroups_db.get(expertgroup_id);
        
        // Initialize agentIds if it doesn't exist
        if(!expertgroup.agentIds)
            expertgroup.agentIds = [];
        
        // Initialize agents array if it doesn't exist (new format)
        if(!expertgroup.agents)
            expertgroup.agents = [];
        
        // Handle both old format (agentId only) and new format (full agent object with permissions)
        if(body.agentId) {
            // Old format: only agent ID provided
            expertgroup.agentIds.push_back(body.agentId);
        } 
		
		if(body.agent && body.agent.id) {
            // New format: full agent object with permissions
            agentObj = body.agent;
            
            // Set default values for new permission attributes if not provided
            if(agentObj.canReadFiles == None) agentObj.canReadFiles = false;
            if(agentObj.canWriteFiles == None) agentObj.canWriteFiles = false;
            if(agentObj.canUseSkills == None) agentObj.canUseSkills = false;
            
            // Add agent ID to list
            expertgroup.agentIds.push_back(agentObj.id);
            
            // Add full agent object to agents array
            expertgroup.agents.push_back(agentObj);
        }
        
        // Update timestamp
        expertgroup.updatedAt = std.millis();
        
        // Save updated expert group
        expertgroups_db.put(expertgroup_id, expertgroup);
        
        return [body = format_api_response(true, expertgroup.agentIds)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// DELETE /api/expertgroups/:id/agents/:agentId - Remove agent from expert group
server.route("DELETE", "^/api/expertgroups/([a-zA-Z0-9_-]+)/agents/([a-zA-Z0-9_-]+)$", [this](req, res) {
    
    if(!expertgroups_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    expertgroup_id = req.matches[0];
    agent_id = req.matches[1];
    
    try {
        if(!expertgroups_db.exists(expertgroup_id)) {
            return [body = format_api_response(false, None, "Expert group not found")];
        }
        
        expertgroup = expertgroups_db.get(expertgroup_id);
        
        // Initialize agentIds if it doesn't exist
        if(expertgroup.agentIds == None)
            expertgroup.agentIds = [];
        
        // Remove agent ID from list
        new_agentIds = [];
        for(i = 0; i < expertgroup.agentIds.size(); i++) {
			agentId = expertgroup.agentIds[i];
            if(agentId != agent_id)
                new_agentIds.push_back(agentId);
        }
        expertgroup.agentIds = new_agentIds;
        
		//Remove from new format...
		for(i = 0; i < expertgroup.agents.size(); i++) {
			if(expertgroup.agents[i].id == agent_id) {
				expertgroup.agents.erase(i);
				break;
			}
		}
		
        // Update timestamp
        expertgroup.updatedAt = std.millis();
        
        // Save updated expert group
        expertgroups_db.put(expertgroup_id, expertgroup);
        
        return [body = format_api_response(true, expertgroup.agentIds)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// GET /api/expertgroups/:id/agents/:agentId - Get specific agent in group
server.route("GET", "^/api/expertgroups/([a-zA-Z0-9_-]+)/agents/([a-zA-Z0-9_-]+)$", [this](req, res) {
    
    if(!expertgroups_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    expertgroup_id = req.matches[0];
    agent_id = req.matches[1];
    
    try {
        if(!expertgroups_db.exists(expertgroup_id)) {
            return [body = format_api_response(false, None, "Expert group not found")];
        }
        
        expertgroup = expertgroups_db.get(expertgroup_id);
        
        // Get agents list
        agents = [];
        if(expertgroup.agents)
            agents = expertgroup.agents;
        
        // Find specific agent
        for(i = 0; i < agents.size(); i++) {
            agent = agents[i];
            if(agent.id && agent.id == agent_id)
                return [body = format_api_response(true, agent)];
        }
        
        return [body = format_api_response(false, None, "Agent not found")];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// PUT /api/expertgroups/:id/agents/:agentId - Update agent in group
server.route("PUT", "^/api/expertgroups/([a-zA-Z0-9_-]+)/agents/([a-zA-Z0-9_-]+)$", [this](req, res) {
    
    if(!expertgroups_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    expertgroup_id = req.matches[0];
    agent_id = req.matches[1];
    body = parse_expertgroup_request_body(req.body);
    
    if(!body) {
        return [body = format_api_response(false, None, "Invalid request body")];
    }
    
	std.print(body);
	
    try {
        if(!expertgroups_db.exists(expertgroup_id)) {
            return [body = format_api_response(false, None, "Expert group not found")];
        }
        
        expertgroup = expertgroups_db.get(expertgroup_id);
        
        // Get agents list or initialize
        agents = [];
        if(expertgroup.agents)
            agents = expertgroup.agents;
        
        // Find and update agent
        updated = false;
        for(i = 0; i < agents.size(); i++) {
            agent = agents[i];
            if(agent.id && agent.id == agent_id) {
                // Update provided fields
                if(body.name)
                    agent.name = body.name;
                if(body.role)
                    agent.role = body.role;
                if(body.personality)
                    agent.personality = body.personality;
                if(body.color)
                    agent.color = body.color;
                if(body.avatar)
                    agent.avatar = body.avatar;
                
                // Update permission attributes with defaults
                if(body.canReadFiles)
                    agent.canReadFiles = body.canReadFiles;
                else if(!agent.canReadFiles)
                    agent.canReadFiles = false;
                    
                if(body.canWriteFiles)
                    agent.canWriteFiles = body.canWriteFiles;
                else if(!agent.canWriteFiles)
                    agent.canWriteFiles = false;
                    
                if(body.canUseSkills)
                    agent.canUseSkills = body.canUseSkills;
                else if(!agent.canUseSkills)
                    agent.canUseSkills = false;
                
                agents[i] = agent;
                updated = true;
                break;
            }
        }
        
        if(!updated) {
            // Just create a new one...
			// Update provided fields
			agent = [id=agent_id];
			if(body.name)
				agent.name = body.name;
			if(body.role)
				agent.role = body.role;
			if(body.personality)
				agent.personality = body.personality;
			if(body.color)
				agent.color = body.color;
			if(body.avatar)
				agent.avatar = body.avatar;
			
			// Update permission attributes with defaults
			if(body.canReadFiles)
				agent.canReadFiles = body.canReadFiles;
			else if(!agent.canReadFiles)
				agent.canReadFiles = false;
				
			if(body.canWriteFiles)
				agent.canWriteFiles = body.canWriteFiles;
			else if(!agent.canWriteFiles)
				agent.canWriteFiles = false;
				
			if(body.canUseSkills)
				agent.canUseSkills = body.canUseSkills;
			else if(!agent.canUseSkills)
				agent.canUseSkills = false;
			
			expertgroup.agents.push_back(agent);
        }
		
        // Update agents list in group
        expertgroup.agents = agents;
        expertgroup.updatedAt = std.millis();
        
        // Save updated expert group
        expertgroups_db.put(expertgroup_id, expertgroup);
        
        return [body = format_api_response(true, agents)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

