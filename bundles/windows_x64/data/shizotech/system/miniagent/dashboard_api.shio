// Initialize LevelDB for expert groups
expertgroups_db = leveldb.db(agent_space + "dashboard/expertgroups.db");

// Helper function to parse expert group request body
parse_expertgroup_request_body(body) {
    try {
        json = std.json(body);
        // Check if JSON object is empty (size == 0)
        if(json.size && json.size() == 0)
            return None;
        return json;
    }
    catch(e) {
        return None;
    }
}

// GET /api/expertgroups/list - Get all expert groups
server.route("GET", "^/api/expertgroups/list$", [this](req, res) {
    
    if(!expertgroups_db)
        return [body = format_api_response(false, None, "Not enabled.")];
    
    expertgroups = [];
    
    try {
        managed iter = expertgroups_db.iter();
        
        for(iter.valid()) {
            key = iter.key();
            if(!key)
                break;
            
            value = expertgroups_db.get(key);
            expertgroup = std.json(value);
            
            if(expertgroup)
                expertgroups.push_back(expertgroup);
            
            iter.next();
        }
        
        return [body = format_api_response(true, expertgroups)];
    }
    catch(e) {
        return [body = format_api_response(false, None, std.string(e))];
    }
});

// POST /api/expertgroups - Create new expert group
