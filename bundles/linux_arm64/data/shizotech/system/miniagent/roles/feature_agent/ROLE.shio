
#include "../SHARED"

add_tools(agt)
{
	//This is needed because some models tend to loop forever without an exit...
	agt.add_finalize_tool(false);

	add_read_tools(agt);
	add_code_read_tools(agt);
	add_write_tools(agt);
	add_skill_tools(agt);

	agt.add_tool(
		"plan_set_progress",
		"Set the progress of the current plan.",
		[
			progress = "&int(0,100): Plan progress (0 = initial state, 50 = implementation done, 100 = verification done)",
			summary = "&string(): Summary of the current task state", 
		],
		[](agt, args)
		{				
			//std.print(args.manifest);
			agt.env.progress = args.progress;
			agt.env.summaries.push_back(args.summary);
		
			if(agt.env.on_progress) {
				agt.env.on_progress(args.progress, args.summary);
			}
		
			return [
				ok=true,
				status="Progress updated.",
			];
		}
	);
	
	agt.add_tool(
		"plan_finished",
		"Mark the goal as reached.",
		[
			summary = "&string(): Summary of the current task state", 
		],
		[](agt, args)
		{				
			//std.print(args.manifest);
			agt.env.progress = 100;
			agt.env.summaries.push_back(args.summary);
			agt.env.plan_finished = true;
			agt.env.plan_failed = false;
			agt.stop();
			
			if(agt.env.on_progress) {
				agt.env.on_progress(100, args.summary);
			}
			
			return [
				ok=true,
				status="Goal finished.",
			];
		}
	);
	
	agt.add_tool(
		"plan_failed",
		"Mark the goal as failed.",
		[
			summary = "&string(): Summary of the current task state", 
		],
		[](agt, args)
		{				
			//std.print(args.manifest);
			agt.env.progress = 100;
			agt.env.summaries.push_back(args.summary);
			agt.env.plan_finished = true;
			agt.env.plan_failed = true;
			agt.stop();
			
			if(agt.env.on_progress) {
				agt.env.on_progress(100, args.summary);
			}
			
			return [
				ok=true,
				status="Goal finished.",
			];
		}
	);
}