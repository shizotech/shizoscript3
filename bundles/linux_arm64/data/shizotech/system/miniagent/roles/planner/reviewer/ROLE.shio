
#include "../../../miniagent"
#include "../../SHARED"

add_tools(agt)
{
	//This is needed because some models tend to loop forever without an exit...
	add_read_tools(agt);
	add_code_read_tools(agt);
	add_write_tools(agt);
	//add_skill_tools(agt);

	agt.add_tool(
		"plan_continue",
		"Set the next steps for the plan",
		[
			next_steps = "&string(): Plan for the next steps",
			//working_directory = "&string(): The working directory for the downstream agent.", 
		],
		[](agt, args)
		{				
			fileio.write_string(".plan/next_steps.md", args.next_steps);
			
			agt.env.plan_finished = false;
			agt.env.plan_failed = false;
			agt.env.plan_revert = false;
			
			agt.stop();
			
			return [
				ok=true
			];
		}
	);

	agt.add_tool(
		"plan_revert_last",
		"Revert the very last steps that were reported to you.",
		[
			next_steps = "&string(): Plan for the next steps",
			//working_directory = "&string(): The working directory for the downstream agent.", 
		],
		[](agt, args)
		{				
			fileio.write_string(".plan/next_steps.md", args.next_steps);
			
			agt.env.plan_finished = false;
			agt.env.plan_failed = false;
			agt.env.plan_revert = true;
			
			agt.stop();
			
			return [
				ok=true
			];
		}
	);


	agt.add_tool(
		"plan_finished",
		"Notify goal has been reached.",
		None,
		[](agt, args)
		{				
			agt.env.plan_finished = true;
			agt.env.plan_failed = false;
			agt.env.plan_revert = false;
			agt.stop();
			return [
				ok=true,
			];
		}
	);

	agt.add_tool(
		"plan_failed",
		"Notify goal cannot be achieved.",
		[
			query = "&string(): What to search for",
		],
		[](agt, args)
		{
			agt.env.plan_finished = true;
			agt.env.plan_failed = true;
			agt.env.plan_revert = false;
			agt.stop();
			return [
				ok=true,
			];
		}
	);
}