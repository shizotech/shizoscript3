
#include "../../miniagent"
#include "../SHARED"

add_tools(agt)
{
	//add_read_tools(agt);
	//add_code_read_tools(agt);
	//add_skill_tools(agt);

	agt.add_tool(
		"task",
		"Use downstream agents for direct actions",
		[
			manifest = "&string(): manifest",
			progress = "&int(0,100): task progress",
		],
		[](agt, args)
		{				
			//std.print(args.manifest);
		
			task_prompt = "<global_task>\n" + agt.env.task + "\n</global_task>\n\n**HERE IS YOUR SPECIFIC SUBTASK**\n";
			task_prompt += "<your_task>\n" + args.manifest + "\n</your_task>";
			
			//global_file_lock = std.global("agent_file_lock");
			managed sub_agt = agt.subagent("planner");
			
			if(agt.on_action)
				agt.on_action([start_agent=sub_agt.agent_id]);	

			if(agt.env.on_progress)
				agt.env.on_progress(args.progress);
			
			res = sub_agt.task(task_prompt);
			
			if(agt.on_action)
				agt.on_action([stop_agent=sub_agt.agent_id]);

			return res;
		}
	);
	
	agt.add_tool(
		"finalize",
		"Exit / Terminate execution.",
		[
			status = ["completed", "error"],
			report = "&string(): report manifest",
		],
		[](agt, args)
		{
			agt.stop();
			
			agt.env.report = args.report;
			agt.env.status = args.status;
			
			return "Report submitted, stop now.";
		}
	);
}