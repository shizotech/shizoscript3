

add_tools(agt)
{
	//FILEIO
	agt.add_tool(
		"list_dir",
		"Query files in the current directory",
		[
			path = "&string(): Path to query, use '.' for the current working directory",
			recursive = ["true", "false"],
		],
		[](agt, args)
		{
			if(args.path.starts("/"))
				return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
			
			args.path = args.path.removesuffix("/");
		
			if(!agt.filesystem.exists(args.path))
				return "The directory does not exist.";
		
			dirs = agt.filesystem.dirs(args.path, args.recursive == "true"); 
			files = agt.filesystem.files(args.path, args.recursive == "true"); //Filter out large log files and other stuff
			
			dirs_cleaned = [];
			files_cleaned = [];
			
			//Filter out logfiles
			for(i = 0; i < dirs.size(); i++) {
				if(dirs[i].contains(".agent") || dirs[i].contains(".backup") || dirs[i].contains(".git"))
					continue;
				dirs_cleaned.push_back(dirs[i]);
			}
			for(i = 0; i < files.size(); i++) {
				
				if(files[i].contains(".agent") || files[i].contains(".backup") || files[i].contains(".git"))
					continue;
				files_cleaned[files[i]] = [size=agt.filesystem.size(args.path + "/" + files[i])];
			}
			
			has_files = files_cleaned ? "true" : "false";
			has_dirs = dirs_cleaned ? "true" : "false";
			
			return [
				has_files = has_files,
				has_directories = has_dirs,
				dirs = dirs_cleaned,
				files = files_cleaned,
			];
		}
	);
		

	agt.add_tool(
			"read",
			"Read a file",
			[
				path = "&string(): Path to the file",
			],
			[](agt, args)
			{
				if(args.path.starts("/"))
					return "Invalid path specified. Do not use '/path/to' instead use './path/to' ! Always provide paths from the current working directory './' !";
				return agt.filesystem.read_text(args.path);
			}
		);
		
	//FINAL
	agt.add_tool(
		"final_report",
		"Report, Exit and Terminate",
		[
			report_manifest = "&string(): The REPORT MANIFEST",
		],
		[](agt, args)
		{
			agt.stop();
			
			agt.reports.push_back([report=args.report_manifest, time=std.millis()]);
			
			return "Report submitted, stop now.";
		}
	);
}