// ═════════════════════════════════════════════════════════════════════════════
//  web_ui.shio — the web interface of a node: shz miniagent --web
//
//      shz miniagent --web [--port 13337] [--api-token secret] [--agentspace dir]
//                          [--architecture-role adaptive]
//      shz miniagent.node --web ...                   (the same)
//
//  One HTTP server on the node:
//    /                       the dashboard (web/): chat with the receptionist,
//                            the worker tasks, the architecture graph
//    /api/...                the node JSON API (node_api.shio, node_api.md)
//    /api/adminagent...      the chat protocol of the dashboard chat page
//    /api/architecture...    the architecture board (architecture.shio)
//
//  Every page works offline: no CDN, everything is in web/.
//  With --api-token the pages ask for the token once (kept in the browser).
//
//      #include "web_ui"
//      opts = web_ui_parse(web_ui_args());       // [web, port, api_token, agentspace]
//      ui = web_ui_start(host, cfg, opts);       // [server, board] | None
// ═════════════════════════════════════════════════════════════════════════════

#include "node_api"
#include "architecture"

WEB_UI_DEFAULT_PORT = 13337;
WEB_UI_ROOT = __DIR__ + "/web";

// the command line as a list (index 0, the script, left out)
web_ui_args() {
	args = [];
	for(i = 1; i < std.argc(); i++) {
		a = std.argv(i);
		args.push_back(a ? std.string(a) : "");
	}
	return args;
}

web_ui_value(args, flag) {
	for(i = 0; i < args.size(); i++) {
		a = std.string(args[i]);
		if(a == flag && i + 1 < args.size())
			return std.string(args[i + 1]);
		if(a.starts(flag + "="))
			return a.substr(flag.length() + 1);
	}
	return "";
}

web_ui_has(args, flag) {
	for(a : args) {
		if(std.string(a) == flag)
			return true;
	}
	return false;
}

// -> [web, port, api_token, agentspace, architecture_role]
//    web: --web (also --web=<port>); port: --port, else 13337
//    architecture_role: --architecture-role, the role of the graph's job tasks (adaptive)
web_ui_parse(args) {
	web = web_ui_has(args, "--web");
	port = WEB_UI_DEFAULT_PORT;

	inline = web_ui_value(args, "--web");
	if(inline && !inline.starts("--") && std.int(inline) > 0) {
		web = true;
		port = std.int(inline);
	}

	p = web_ui_value(args, "--port");
	if(p && std.int(p) > 0)
		port = std.int(p);

	space = web_ui_value(args, "--agentspace");
	if(!space)
		space = ".agentspace";

	role = web_ui_value(args, "--architecture-role");
	if(!role)
		role = "adaptive";

	return [
		web = web,
		port = port,
		api_token = web_ui_value(args, "--api-token"),
		agentspace = space,
		architecture_role = role,
	];
}

// ─────────────────────────────────────────────────────────────────────────────
//  /api/adminagent: the protocol of web/chat/script.js on the node's receptionist
// ─────────────────────────────────────────────────────────────────────────────

// a receptionist action -> the delta of the chat page (None: not shown)
web_ui_chat_delta(action) {
	if(!std.is_json(action))
		return None;

	if(action.has("text") && action.text)
		return [agent = "planner", text = std.string(action.text)];

	// a tool call arrives twice: as "tool" (the model's call) and as "tool_start"
	// (the harness runs it); the chat shows it once
	tool = None;
	if(action.has("tool_start") && std.is_json(action.tool_start))
		tool = action.tool_start;

	if(!tool || !tool.has("name"))
		return None;

	name = std.string(tool.name);
	args = tool.has("args") && std.is_json(tool.args) ? tool.args : std.json();

	if(name == "finish" && args.has("summary"))
		return [agent = "planner", text = "\n\n" + std.string(args.summary)];

	text = "\n> [TOOL] " + name;
	if(args.has("name") && args.name)
		text += " `" + std.string(args.name) + "`";
	else if(args.has("path") && args.path)
		text += " `" + std.string(args.path) + "`";
	return [agent = "planner", text = text + "\n\n"];
}

web_ui_chat_routes(server, host, api_token) {
	sessions = [];		// client ip -> [token, queue, status]

	server.route("POST", "^/api/adminagent$", [host, sessions, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);

		body = node_api_body(req);
		prompt = node_api_get(body, "prompt");
		if(!prompt.strip())
			return node_api_err("Missing 'prompt'");

		client = std.string(req.client_ip);
		token = node_api_get(body, "session_id");
		if(!token)
			token = std.random_hash(16);

		sessions[client] = [token = token, queue = [], status = "generating", started = std.millis()];

		run = [host, sessions, client, token, prompt]() {
			on_action = [sessions, client, token](action) {
				if(!sessions.has(client) || sessions[client].token != token)
					return;
				d = web_ui_chat_delta(action);
				if(d)
					sessions[client].queue.push_back(d);
			};
			result = None;
			try {
				result = host.request(prompt, None, on_action);
			}
			catch(e) {
				result = [ok = false, error = std.string(e)];
			}
			if(!sessions.has(client) || sessions[client].token != token)
				return;
			// the report of the turn closes the answer (the finish summary is
			// streamed already, so only a turn without one adds its report)
			if(std.is_json(result) && !result.ok) {
				txt = std.string(result.error ?? "the turn failed");
				if(std.is_json(result.reports) && result.reports.size())
					txt = std.string(result.reports[0].report);
				sessions[client].queue.push_back([agent = "planner", text = "\n\n" + txt]);
			}
			sessions[client].status = "done";
		};
		std.thread(run).run();

		return [status_code = 200, headers = node_api_headers(), body = std.string([ok = 1, session_id = token])];
	});

	server.route("POST", "^/api/adminagent/poll$", [sessions, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);

		body = node_api_body(req);
		client = std.string(req.client_ip);
		reply = [ok = true, status = "done"];

		if(sessions.has(client)) {
			s = sessions[client];
			if(s.token != node_api_get(body, "session_id")) {
				reply = [ok = false, status = "error", error = "unknown session"];
			}
			else if(s.queue.size()) {
				d = s.queue[0];
				s.queue.erase(0);
				// consecutive text of the same agent in one delta
				for(s.queue.size() && s.queue[0].agent == d.agent) {
					d.text += s.queue[0].text;
					s.queue.erase(0);
				}
				reply = [ok = true, status = "generating", delta = d];
			}
			else if(s.status == "done") {
				sessions.erase(client);
				reply = [ok = true, status = "done"];
			}
			else
				reply = [ok = true, status = "waiting"];
		}

		return [status_code = 200, headers = node_api_headers(), body = std.string(reply)];
	});

	server.route("POST", "^/api/adminagent/stop$", [host, sessions, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);

		client = std.string(req.client_ip);
		if(sessions.has(client)) {
			sessions.erase(client);
			try {
				host.receptionist.stop();
			}
			catch(e) {}
		}
		return [status_code = 200, headers = node_api_headers(), body = std.string([ok = true])];
	});
}

// ─────────────────────────────────────────────────────────────────────────────
//  /api/architecture: the board
// ─────────────────────────────────────────────────────────────────────────────

web_ui_board_reply(res) {
	if(std.is_json(res) && res.has("ok") && !res.ok)
		return node_api_err(std.string(res.error ?? "failed"), 409);
	return node_api_ok(res);
}

web_ui_architecture_routes(server, board, api_token) {
	server.route("GET", "^/api/architecture$", [board, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);
		return node_api_ok(board.state());
	});

	server.route("POST", "^/api/architecture/analyze$", [board, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);
		return web_ui_board_reply(board.analyze());
	});

	server.route("POST", "^/api/architecture/edits$", [board, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);
		body = node_api_body(req);
		if(std.is_none(body))
			return node_api_err("Invalid request body");
		return web_ui_board_reply(board.add_edit(body));
	});

	server.route("DELETE", "^/api/architecture/edits/([0-9a-zA-Z_-]+)$", [board, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);
		n = board.remove_edit(std.string(req.matches[0]));
		if(!n)
			return node_api_err("unknown edit", 404);
		return node_api_ok([removed = n]);
	});

	server.route("POST", "^/api/architecture/discard$", [board, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);
		return node_api_ok([removed = board.discard_edits()]);
	});

	server.route("POST", "^/api/architecture/layout$", [board, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);
		body = node_api_body(req);
		if(std.is_none(body) || !body.has("positions"))
			return node_api_err("Missing 'positions'");
		return node_api_ok([moved = board.set_layout(body.positions)]);
	});

	server.route("POST", "^/api/architecture/plan$", [board, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);
		body = node_api_body(req);
		return web_ui_board_reply(board.review_plan(node_api_get(body, "feedback")));
	});

	server.route("POST", "^/api/architecture/apply$", [board, api_token](req, writer) {
		if(!node_api_authorized(req, api_token))
			return node_api_err("Unauthorized", 401);
		return web_ui_board_reply(board.apply());
	});
}

// -> [server, board], None when the port cannot be bound
web_ui_start(host, cfg, opts) {
	port = std.int(opts.port ?? WEB_UI_DEFAULT_PORT);
	token = std.string(opts.api_token ?? "");
	space = std.string(opts.agentspace ?? ".agentspace");

	server = node_api_start(host, cfg, port, token, WEB_UI_ROOT);
	if(!server)
		return None;

	board = ArchitectureBoard(host, space, std.string(opts.architecture_role ?? "adaptive"));

	web_ui_chat_routes(server, host, token);
	web_ui_architecture_routes(server, board, token);

	return [server = server, board = board];
}
